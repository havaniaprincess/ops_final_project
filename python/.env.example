# Настройки сервиса документации.
# Скопируйте в .env и при необходимости поменяйте: cp .env.example .env
# Файл .env в git не попадает.

# Имя крейта: в папке с таким именем rustdoc кладёт главную страницу (index.html)
CRATE_NAME=ops_app

# Папка с результатом `cargo doc`. Относительный путь считается от папки,
# из которой запущен сервис. По умолчанию ../target/doc — раскомментируйте,
# только если документация лежит в другом месте.
# В Docker не задавайте: образ использует свою папку /app/doc.
#DOCS_DIR=../target/doc

# Уровень логов: DEBUG, INFO, WARNING, ERROR. Логи идут в stdout (в Docker — docker logs)
LOG_LEVEL=INFO
